{
  "manifest_version": 3,
  "name": "Aurora Downloader",
  "version": "2.0.0.3",
  "description": "Download videos from YouTube and other sites as MKV, MP4, audio and more with yt-dlp on your computer. Queue, history, clips, playlists.",
  "key": "",
  "minimum_chrome_version": "116",
  "background": {
    "service_worker": "background.js"
  },
  "permissions": [
    "nativeMessaging",
    "activeTab",
    "scripting",
    "notifications",
    "storage",
    "downloads",
    "alarms"
  ],
  "host_permissions": [
    "https://api.github.com/*"
  ],
  "commands": {
    "download-default": {
      "suggested_key": {
        "default": "Alt+Shift+D"
      },
      "description": "Download the current page's video with my default settings"
    }
  },
  "action": {
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    },
    "default_title": "Download this video (yt-dlp)",
    "default_popup": "popup/popup.html"
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "96": "icons/icon-96.png",
    "128": "icons/icon-128.png"
  }
}
